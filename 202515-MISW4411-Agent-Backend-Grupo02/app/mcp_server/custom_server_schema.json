{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Custom MCP Server Schema",
  "description": "Schema para el servidor MCP del Agente Especializado",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Nombre del servidor MCP",
          "default": "custom-server"
        },
        "version": {
          "type": "string",
          "description": "Versión del servidor",
          "default": "1.0.0"
        }
      },
      "required": ["name"]
    },
    "tools": {
      "type": "array",
      "description": "Lista de herramientas expuestas por el servidor",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nombre de la herramienta"
          },
          "description": {
            "type": "string",
            "description": "Descripción de la herramienta"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["object"]
              },
              "properties": {
                "type": "object",
                "description": "Propiedades de entrada de la herramienta"
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Campos requeridos"
              }
            },
            "required": ["type", "properties"]
          }
        },
        "required": ["name", "description", "inputSchema"]
      }
    },
    "configuration": {
      "type": "object",
      "description": "Configuración del servidor",
      "properties": {}
    }
  },
  "required": ["server", "tools"]
}

