{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RAG MCP Server Schema",
  "description": "Schema para el servidor MCP del Agente RAG",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Nombre del servidor MCP",
          "default": "rag-server"
        },
        "version": {
          "type": "string",
          "description": "Versión del servidor",
          "default": "1.0.0"
        }
      },
      "required": ["name"]
    },
    "tools": {
      "type": "array",
      "description": "Lista de herramientas expuestas por el servidor",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nombre de la herramienta",
            "enum": ["ask"]
          },
          "description": {
            "type": "string",
            "description": "Descripción de la herramienta",
            "default": "Consulta el sistema RAG externo para recuperar contexto relevante"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["object"]
              },
              "properties": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "La pregunta del usuario que se enviará al RAG"
                  }
                },
                "required": ["query"]
              }
            },
            "required": ["type", "properties"]
          }
        },
        "required": ["name", "description", "inputSchema"]
      }
    },
    "configuration": {
      "type": "object",
      "properties": {
        "RAG_BASE_URL": {
          "type": "string",
          "description": "URL base del sistema RAG externo",
          "format": "uri"
        },
        "RAG_COLLECTION": {
          "type": "string",
          "description": "Nombre de la colección en el RAG",
          "default": "test_collection"
        },
        "RAG_TOP_K": {
          "type": "integer",
          "description": "Número de resultados a recuperar",
          "default": 5,
          "minimum": 1
        }
      }
    }
  },
  "required": ["server", "tools"]
}

